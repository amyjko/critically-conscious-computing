{
  "hosting": {
    "public": "build",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/1/**",
        "destination": "/1/404.html"
      },
      {
        "source": "**",
        "destination": "/404.html"
      }
    ]
  },
  "emulators": {
    "hosting": {
      "port": 8000
    }
  }
}
